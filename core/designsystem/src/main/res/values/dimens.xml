    <!--
        透镜折射参数（对齐 LootArchive 的 `lens(12.dp.toPx(), 24.dp.toPx())`）：
        refraction_depth = 折射带宽度（距边缘多深以内参与折射），
        refraction_amount = 折射位移上限（边缘处最多向外取样多少像素）。
        两者都为 0 时玻璃面退化为「提饱和 + 模糊」，不做折射。
    -->
    <dimen name="m3t_glass_refraction_depth">12dp</dimen>
    <dimen name="m3t_glass_refraction_amount">24dp</dimen>
