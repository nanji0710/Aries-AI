    <!--
        Salt 风格度量（对齐 Salt Player / SaltUI 2.3.x）：
        卡片圆角 medium = 12dp、行高 SaltDimensItem = 56dp、行图标 SaltDimensItemIcon = 24dp。
        这些值与玻璃令牌并存：玻璃负责「面」，Salt 度量负责「骨」。
    -->
    <dimen name="m3t_salt_card_radius">12dp</dimen>
    <dimen name="m3t_salt_item_height">56dp</dimen>
    <dimen name="m3t_salt_item_icon">24dp</dimen>

